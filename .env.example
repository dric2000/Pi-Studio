# Envoi du formulaire de contact via Resend (https://resend.com).
# Sans RESEND_API_KEY, le formulaire fonctionne en mode démonstration : rien n'est envoyé,
# le visiteur est invité à transmettre son brief par email ou WhatsApp.
RESEND_API_KEY=
# Destinataire des briefs (par défaut : l'email public du studio).
CONTACT_TO_EMAIL=
# Expéditeur, sur un domaine vérifié chez Resend (par défaut : l'adresse de test de Resend).
CONTACT_FROM_EMAIL=

# Adresse publique du site (ex. https://pi-studio.ci), utilisée pour les aperçus de partage.
NEXT_PUBLIC_SITE_URL=
